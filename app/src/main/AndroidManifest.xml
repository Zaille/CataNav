<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      CataNav privacy contract: NO location permissions, NO network permissions.
      Allowed set (enforced by ManifestAuditTest):
        FOREGROUND_SERVICE, FOREGROUND_SERVICE_HEALTH, WAKE_LOCK,
        HIGH_SAMPLING_RATE_SENSORS, ACTIVITY_RECOGNITION, POST_NOTIFICATIONS.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CataNavApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.CataNav">

        <activity
            android:name=".ui.MapsActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:launchMode="singleTop" />

        <activity
            android:name=".ui.CalibrateMapActivity"
            android:exported="false"
            android:label="@string/title_calibrate_map" />
        <activity
            android:name=".ui.StepCalibrationActivity"
            android:exported="false"
            android:label="@string/title_calibration" />
        <activity
            android:name=".ui.CalibrationTestActivity"
            android:exported="false"
            android:label="@string/title_calibration_test" />
        <activity
            android:name=".ui.HistoryActivity"
            android:exported="false"
            android:label="@string/title_history" />
        <activity
            android:name=".ui.TripDetailActivity"
            android:exported="false"
            android:label="@string/title_trip_detail" />
        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false"
            android:label="@string/title_settings" />

        <service
            android:name=".service.TrackingService"
            android:exported="false"
            android:foregroundServiceType="health" />
    </application>

</manifest>
